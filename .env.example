# Copy to .env for optional local overrides. Never commit .env.
APP_PASSWORD=budget-local-dev
API_PORT=8000
WEB_PORT=5173
# Default development storage: backend/data/budget.db (SQLite, exact integer cents).
# DATABASE_URL=postgresql+psycopg://budget:password@127.0.0.1:5432/budget

# Set ALL of these to strong, unique values before VPS deployment.
# Production refuses the development password and missing/short secrets.
# APP_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
# SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# POSTGRES_PASSWORD=replace-with-a-strong-database-password
# DOMAIN=budget.example.com
